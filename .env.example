GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
PORT=3000

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change_me_32_byte_random_secret
JWT_REFRESH_SECRET=change_me_a_different_32_byte_secret

# Email (password-reset OTP) via SMTP + nodemailer. Leave unset in dev — the OTP
# is logged to console and returned as dev_otp instead. Any SMTP relay works,
# e.g. smtp.gmail.com with an app password, smtp.brevo.com, or Mailtrap for tests.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=NaijaTaste AI <noreply@example.com>

# Frontend (Vite). Dev default: http://localhost:3000 — prod default is your deployed API URL.
# VITE_API_URL=http://localhost:3000
