GEMINI_API_KEY=your_gemini_api_key_here
# Default model. The llm.service chain degrades automatically if it is slow,
# overloaded or missing: gemini-3.5-flash-lite -> gemini-3.5-flash ->
# gemini-3.6-flash (probes/gemini-models.mjs, 2026-10-20).
GEMINI_MODEL=gemini-3.5-flash-lite
# Hard ceiling for ALL Gemini attempts + retries in one request. Must stay
# below the Vercel function maxDuration (vercel.json: 60s) with room for the
# cold start (~5s).
GEMINI_TOTAL_TIMEOUT_MS=35000
# Ceiling for a single attempt; the total budget always wins.
GEMINI_ATTEMPT_TIMEOUT_MS=20000
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change_me_32_byte_random_secret
JWT_REFRESH_SECRET=change_me_a_different_32_byte_secret

# Email (password-reset OTP) via SMTP + nodemailer. Leave unset in dev — the OTP
# is logged to console and returned as dev_otp instead. Any SMTP relay works,
# e.g. smtp.gmail.com with an app password, smtp.brevo.com, or Mailtrap for tests.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=NaijaTaste AI <noreply@example.com>

# Error tracking (Sentry). Leave unset for a quiet no-op; set a project DSN in
# Vercel project settings to enable server-side error capture. Never commit a
# real DSN here.
# SENTRY_DSN=https://<public_key>@<org>.ingest.sentry.io/<project>

# Rate limiting + CORS (plan 006)
RATE_LIMIT_API_MAX=600
RATE_LIMIT_LLM_MAX=10
# CORS_ORIGIN=https://your-frontend.example.com (comma-separated for several)
# REQUIRED in production (server refuses to boot without it); optional in dev.
# TRUST_PROXY=1  # default 1; set 0 to disable when not behind a proxy

# Google sign-in (Web OAuth client ID from Google Cloud Console — no secret needed)
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Dev OTP fallback: ONLY for local development. Returns the reset code as
# dev_otp in the forgot-password response. NEVER enable in production or
# any shared deploy — anyone with an email could take over accounts.
# DEV_OTP_ENABLED=false

# Database (Neon Postgres, free tier, no card). REQUIRED in production.
# Runtime uses the pooled URL (…-pooler…); migrations use the direct URL.
# Locally and in tests the app uses ephemeral pg-mem automatically.
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# DATABASE_URL_DIRECT=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# Frontend (Vite). Dev default: http://localhost:3000 — prod default is your deployed API URL.
# VITE_API_URL=http://localhost:3000
